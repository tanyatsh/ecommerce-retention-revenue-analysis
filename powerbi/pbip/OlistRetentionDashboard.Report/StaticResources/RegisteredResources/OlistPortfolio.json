{
  "name": "Olist Portfolio",
  "dataColors": [
    "#1F7A8C",
    "#E76F51",
    "#2A9D8F",
    "#E9C46A",
    "#457B9D",
    "#8D6A9F",
    "#6C757D",
    "#B56576"
  ],
  "background": "#F6F8FB",
  "foreground": "#172B4D",
  "tableAccent": "#1F7A8C",
  "good": "#2A9D8F",
  "neutral": "#E9C46A",
  "bad": "#E76F51",
  "maximum": "#1F7A8C",
  "center": "#E9C46A",
  "minimum": "#F4A6A0",
  "null": "#D9E1EA",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 18,
      "color": "#172B4D"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#172B4D"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#40526B"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#172B4D"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D9E1EA"
              }
            },
            "radius": 8
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "foreground": {
              "solid": {
                "color": "#60748A"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 20
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#172B4D"
              }
            },
            "alignment": "left"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 28,
            "color": {
              "solid": {
                "color": "#172B4D"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#60748A"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#172B4D"
              }
            }
          }
        ],
        "values": [
          {
            "fontFamily": "Segoe UI",
            "fontColorPrimary": {
              "solid": {
                "color": "#26384A"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F6F8FB"
              }
            }
          }
        ]
      }
    }
  }
}