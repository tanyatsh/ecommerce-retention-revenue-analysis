		sourceColumn: retention_rate

		annotation SummarizationSetBy = Automatic

	column 'Cohort Month Label' = FORMAT('Cohort Retention'[cohort_month], "MMM yyyy", "en-US")
		dataType: string
		lineageTag: 5bdbb2d7-f3d8-4b13-8f4a-8537f7b5f26d
		summarizeBy: none
		sortByColumn: cohort_month

	partition 'Cohort Retention' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents("C:\Users\User\Documents\ChatGPT\ecommerce-retention-analysis\data\processed\cohort_retention.csv"), [Delimiter = ",", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Headers, {{"cohort_month", type date}, {"month_number", Int64.Type}, {"cohort_size", Int64.Type}, {"retained_customers", Int64.Type}, {"observation_cutoff", type date}, {"observation_window_complete", type logical}, {"retention_rate", type number}}, "en-US")
				in
					Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

