		sourceColumn: cohort_size

	column retained_customers
		dataType: int64
		lineageTag: 4f358cb4-47c6-40d2-bc21-dbe5e9d05955
		summarizeBy: sum
		sourceColumn: retained_customers

	column observation_cutoff
		dataType: dateTime
		isHidden
		formatString: Long Date
		lineageTag: 0adff601-fc1a-46ad-b8b6-fa7f54115cde
		summarizeBy: none
		sourceColumn: observation_cutoff

		variation Изменение
			isDefault
			relationship: a79ced8e-1d38-452a-9b58-464a476dd29d
			defaultHierarchy: LocalDateTable_41358b1e-1732-4f7c-b02b-ebd73f5abef7.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	column observation_window_complete
		dataType: boolean
		lineageTag: 42f15e60-2e1c-4009-a589-8fc31f5e9447
