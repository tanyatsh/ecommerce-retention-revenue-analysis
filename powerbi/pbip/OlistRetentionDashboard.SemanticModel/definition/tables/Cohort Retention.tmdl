table 'Cohort Retention'
	lineageTag: 323e9c0d-3812-49a0-a99a-f9824f025082

	measure 'Cohort Retention %' = MAX('Cohort Retention'[retention_rate])
		formatString: 0.0%
		lineageTag: cce6bef9-0643-4e74-bb83-e275b37f7a04

	column cohort_month
		dataType: dateTime
		formatString: MMM yyyy
		lineageTag: b5880871-5ccc-4e40-afa6-63114265fdc3
		summarizeBy: none
		sourceColumn: cohort_month

		variation Изменение
			isDefault
			relationship: 1f9b74ae-2b10-4b84-a7f5-a3de7d8cf792
			defaultHierarchy: LocalDateTable_210afa16-c71b-4910-99f9-c75c46d0954b.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	column month_number
		dataType: int64
		lineageTag: 342ff074-cada-40da-898d-96663e2b818a
		summarizeBy: sum
		sourceColumn: month_number

		annotation SummarizationSetBy = Automatic

	column cohort_size
		dataType: int64
		isHidden
		lineageTag: 482866a2-7660-49f0-827c-cb9d449da476
